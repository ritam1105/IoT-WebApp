<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/output.css">
    <link rel="icon" href="/images/logo.png">
    <title>Login — Matri Ganga</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=DM+Sans:wght@300;400;500;600&display=swap');
        body { font-family: 'DM Sans', sans-serif; }
        .mono { font-family: 'Space Mono', monospace; }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .fade-up   { animation: fadeUp 0.6s ease both; }
        .fade-up-2 { animation: fadeUp 0.6s 0.1s ease both; }
        .fade-up-3 { animation: fadeUp 0.6s 0.2s ease both; }

        .input-field {
            background: rgb(15 23 42);
            border: 1px solid rgb(51 65 85);
            color: white;
            border-radius: 0.75rem;
            padding: 0.75rem 1rem;
            width: 100%;
            font-size: 0.875rem;
            transition: border-color 0.2s, box-shadow 0.2s;
            outline: none;
            font-family: 'DM Sans', sans-serif;
        }
        .input-field:focus {
            border-color: rgb(52 211 153);
            box-shadow: 0 0 0 3px rgb(52 211 153 / 0.1);
        }
        .input-field::placeholder { color: rgb(71 85 105); }

        /* Grid background */
        .grid-bg {
            background-image:
                linear-gradient(rgb(51 65 85 / 0.2) 1px, transparent 1px),
                linear-gradient(90deg, rgb(51 65 85 / 0.2) 1px, transparent 1px);
            background-size: 40px 40px;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen grid-bg flex flex-col items-center justify-center px-6 py-16">

    <!-- Back -->
    <a href="/" class="fade-up absolute top-6 left-6 mono text-xs text-slate-500 hover:text-slate-300 transition-colors">
        ← BACK
    </a>

    <!-- Card -->
    <div class="fade-up-2 w-full max-w-md">

        <!-- Brand -->
        <div class="flex items-center gap-3 mb-8">
            <img src="/images/logo.png" alt="Logo" class="w-9 h-9 rounded-full object-cover ring-1 ring-slate-700">
            <div>
                <p class="mono text-xs text-slate-500 tracking-widest">MATRI GANGA</p>
                <p class="text-white font-semibold text-sm">Water Quality Monitor</p>
            </div>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8">

            <div class="mb-6">
                <h1 class="mono text-xl font-bold text-white mb-1">Welcome back</h1>
                <p class="text-slate-500 text-sm">Sign in to access your dashboard</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-500/10 border border-red-500/30 rounded-xl px-4 py-3 mb-5">
                <p class="text-red-400 text-sm mono"><%= error %></p>
            </div>
            <% } %>

            <form action="/login" method="POST" class="space-y-4">

                <div>
                    <label class="mono text-xs text-slate-500 tracking-widest block mb-2">EMAIL</label>
                    <input type="email" name="email" class="input-field" placeholder="you@example.com" required>
                </div>

                <div>
                    <label class="mono text-xs text-slate-500 tracking-widest block mb-2">PASSWORD</label>
                    <input type="password" name="password" class="input-field" placeholder="••••••••" required>
                </div>

                <div class="pt-2">
                    <button type="submit"
                        class="w-full mono text-xs font-bold py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition-colors duration-200 tracking-widest shadow-lg shadow-emerald-500/20">
                        SIGN IN →
                    </button>
                </div>

            </form>

        </div>

        <p class="fade-up-3 text-center text-slate-600 text-sm mt-5">
            Don't have an account?
            <a href="/signup" class="text-emerald-400 hover:text-emerald-300 transition-colors font-medium">Sign up</a>
        </p>

    </div>

    <!-- Footer -->
    <p class="mono text-xs text-slate-800 mt-12">© 2025 Aqua-Innovators</p>

</body>
</html>
